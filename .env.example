# Canonical workspace identifiers, separated by commas. Defaults to server cwd.
LOR_ALLOWED_WORKSPACES=/path/to/project
LOR_GLOBAL_READ=true
LOR_GLOBAL_WRITE=false
LOR_ALLOW_LOCAL_FILES=false
LOR_ALLOW_ALIAS_MANAGEMENT=false
LOR_HOST=127.0.0.1
LOR_PORT=8765
# LOR_DB_PATH=/path/to/catalog.db
# LOR_SKILL_ROOTS=/path/to/skills
